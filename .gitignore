# ------------------------------------------------------------
# .gitignore — FreeToken-Vulkan
# ------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/

# Compiled shaders (regenerated by CMake)
*.spv

# CMake build tree
build/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake

# MSVC / Windows build artifacts
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.exe
*.dll
*.pyd
.vs/

# Dev helper scripts (personal — hardcode local paths)
_run_*.bat
_build_*.bat
_bench_*.bat
_smoke_*.bat

# Test / benchmark output logs
_*_out.log
*.log

# Downloaded model weights (kept outside the repo)
/gpt-oss-*/
/Qwen*/
/DeepSeek*/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
