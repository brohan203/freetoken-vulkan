#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
layout(local_size_x=128) in;
layout(std430,binding=0) readonly buffer QWBuf { uint qweight[]; };
layout(std430,binding=1) readonly buffer QZBuf { uint qzeros[]; };
layout(std430,binding=2) readonly buffer SBuf { uint16_t scales[]; };
layout(std430,binding=3) readonly buffer XBuf { float X[]; };
layout(std430,binding=4) writeonly buffer PBuf { float partials[]; };
layout(push_constant) uniform P { uint N;uint K;uint group_size;uint chunk_k; } p;
float bf16(uint bits){return uintBitsToFloat(bits<<16u);}
uint slot_for(uint logical){const uint slots[8]=uint[](0u,4u,1u,5u,2u,6u,3u,7u);return slots[logical];}
void main(){uint n=gl_WorkGroupID.x*128u+gl_LocalInvocationID.x,chunk=gl_WorkGroupID.y;if(n>=p.N)return;uint packed_cols=(p.N+7u)/8u,pack=n/8u,slot=slot_for(n&7u),begin=chunk*p.chunk_k,end=min(begin+p.chunk_k,p.K);float acc=0.0;for(uint k=begin;k<end;++k){uint qw=qweight[k*packed_cols+pack],qz=qzeros[(k/p.group_size)*packed_cols+pack];float w=float((qw>>(4u*slot))&15u),z=float((qz>>(4u*slot))&15u),s=bf16(uint(scales[(k/p.group_size)*p.N+n]));acc=fma(X[k],(w-z)*s,acc);}partials[chunk*p.N+n]=acc;}
