#version 450
// flash_attention_gpt_oss_kv_f32.comp — gpt-oss FlashAttention with KV-cache
// support: S_q may differ from S_kv, and past_len is the absolute position
// of the first query token (used for causal + sliding window masking).
//
// Layout:
//   Q       [B, H_q,  S_q,  D]
//   K       [B, H_kv, S_kv, D]
//   V       [B, H_kv, S_kv, D]
//   sinks   [H_q]
//   O       [B, H_q,  S_q,  D]
//
// Semantics:
//   For each output element O[b, h_q, q, d]:
//     absolute_q_pos = past_len + q
//     scores[kv] = Q[b, h_q, q, :] · K[b, h_kv, kv, :] * scale
//     causal:   kv > absolute_q_pos  -> masked
//     sw:       sw>0 AND kv < absolute_q_pos - sw + 1 -> masked
//     softmax over (scores, sink_bias[h_q])
//     O[b, h_q, q, :] = sum_kv (softmax_kv * V[b, h_kv, kv, :])
//
// Dispatch: (S_q, B*H_q, 1). WG=128. One workgroup per (batch, q_head, q_pos).
//
// Compared to flash_attention_gpt_oss_f32.comp: two new push consts (S_q and
// past_len) plus a distinct S_kv (renamed from S). Q, K, V may now differ in
// their second-to-last dim.

#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer BufQ     { float Q[]; };      // [B, H_q,  S_q,  D]
layout(std430, binding = 1) readonly  buffer BufK     { float K[]; };      // [B, H_kv, S_kv, D]
layout(std430, binding = 2) readonly  buffer BufV     { float V[]; };      // [B, H_kv, S_kv, D]
layout(std430, binding = 3) readonly  buffer BufSinks { float sinks[]; };  // [H_q]
layout(std430, binding = 4) writeonly buffer BufO     { float O[]; };      // [B, H_q,  S_q,  D]

layout(push_constant) uniform Params {
    uint S_q;
    uint S_kv;
    uint D;
    uint H_q;
    uint H_kv;
    uint H_q_per_kv;    // H_q / H_kv, precomputed by host
    uint past_len;      // absolute position of Q[0] within the full sequence
    uint sliding_window; // 0 = disabled (causal only)
    uint use_sinks;      // 0 / 1
    float scale;
} p;

const uint BC        = 32;
const uint MAX_D     = 128;
const uint WG        = 128;
const float NEG_LARGE = -3.4e38;

shared float Ks     [BC][MAX_D];
shared float Vs     [BC][MAX_D];
shared float qs     [MAX_D];
shared float os     [MAX_D];
shared float scores [BC];
shared float sdata  [WG];

shared float m_val;
shared float l_val;

void main() {
    const uint q_local   = gl_WorkGroupID.x;         // 0..S_q-1
    const uint bh_idx    = gl_WorkGroupID.y;         // 0..B*H_q-1
    const uint tid       = gl_LocalInvocationID.x;

    const uint S_q       = p.S_q;
    const uint S_kv      = p.S_kv;
    const uint D         = p.D;
    const uint H_q       = p.H_q;
    const uint H_kv      = p.H_kv;

    const uint batch     = bh_idx / H_q;
    const uint head_q    = bh_idx % H_q;
    const uint head_kv   = head_q / p.H_q_per_kv;

    // Absolute position of this query token (used for causal / SWA masks).
    const uint q_abs     = p.past_len + q_local;

    // Flat offsets.
    const uint q_off_base = (batch * H_q  + head_q ) * S_q  * D;
    const uint k_off_base = (batch * H_kv + head_kv) * S_kv * D;
    const uint v_off_base = k_off_base;
    const uint o_off_base = q_off_base;

    // Load Q[batch, head_q, q_local, :] into LDS.
    for (uint d = tid; d < D; d += WG) {
        qs[d] = Q[q_off_base + q_local * D + d];
    }
    for (uint d = tid; d < D; d += WG) os[d] = 0.0;
    if (tid == 0) { m_val = NEG_LARGE; l_val = 0.0; }
    barrier();

    const uint num_blocks = (S_kv + BC - 1u) / BC;

    for (uint b = 0; b < num_blocks; ++b) {
        const uint k_start   = b * BC;
        const uint block_len = min(BC, S_kv - k_start);

        // Cooperatively load K, V for this block.
        for (uint i = tid; i < BC * D; i += WG) {
            const uint kv_row = i / D;
            const uint kv_col = i % D;
            const uint gr     = k_start + kv_row;
            const bool ok     = (kv_row < block_len) && (gr < S_kv);
            Ks[kv_row][kv_col] = ok ? K[k_off_base + gr * D + kv_col] : 0.0;
            Vs[kv_row][kv_col] = ok ? V[v_off_base + gr * D + kv_col] : 0.0;
        }
        barrier();

        // Compute scores with causal + sliding-window mask.
        if (tid < BC) {
            if (tid < block_len) {
                const uint kv_pos = k_start + tid;
                bool masked = (kv_pos > q_abs);      // causal
                if (!masked && p.sliding_window > 0u) {
                    if (q_abs >= p.sliding_window &&
                        kv_pos < q_abs - p.sliding_window + 1u) {
                        masked = true;
                    }
                }
                if (masked) {
                    scores[tid] = NEG_LARGE;
                } else {
                    float acc = 0.0;
                    for (uint d = 0; d < D; ++d) {
                        acc = fma(qs[d], Ks[tid][d], acc);
                    }
                    scores[tid] = acc * p.scale;
                }
            } else {
                scores[tid] = NEG_LARGE;
            }
        }
        barrier();

        // Online softmax renorm.
        sdata[tid] = (tid < BC) ? scores[tid] : NEG_LARGE;
        barrier();
        for (uint s = WG / 2u; s > 0u; s >>= 1u) {
            if (tid < s) sdata[tid] = max(sdata[tid], sdata[tid + s]);
            barrier();
        }
        const float m_block = sdata[0];
        const float m_new   = max(m_val, m_block);
        const float alpha   = exp(m_val - m_new);

        if (tid < BC) {
            if (tid < block_len && scores[tid] > NEG_LARGE * 0.5) {
                scores[tid] = exp(scores[tid] - m_new);
            } else {
                scores[tid] = 0.0;
            }
        }
        barrier();

        sdata[tid] = (tid < BC) ? scores[tid] : 0.0;
        barrier();
        for (uint s = WG / 2u; s > 0u; s >>= 1u) {
            if (tid < s) sdata[tid] += sdata[tid + s];
            barrier();
        }
        const float block_sum = sdata[0];
        const float l_new     = alpha * l_val + block_sum;

        for (uint d = tid; d < D; d += WG) {
            float pv = 0.0;
            for (uint s = 0; s < BC; ++s) {
                pv = fma(scores[s], Vs[s][d], pv);
            }
            os[d] = alpha * os[d] + pv;
        }

        if (tid == 0) { m_val = m_new; l_val = l_new; }
        barrier();
    }

    // Attention sinks: augment softmax denominator with per-head learned bias.
    if (p.use_sinks != 0u) {
        const float sink = sinks[head_q];
        const float m_new = max(m_val, sink);
        const float alpha_old = exp(m_val - m_new);
        const float sink_exp  = exp(sink  - m_new);
        for (uint d = tid; d < D; d += WG) {
            os[d] = alpha_old * os[d];
        }
        if (tid == 0) {
            l_val = alpha_old * l_val + sink_exp;
            m_val = m_new;
        }
        barrier();
    }

    const float inv_l = (l_val > 0.0) ? (1.0 / l_val) : 0.0;
    for (uint d = tid; d < D; d += WG) {
        O[o_off_base + q_local * D + d] = os[d] * inv_l;
    }
}
